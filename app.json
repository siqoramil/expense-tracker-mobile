{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siqoramil.extracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.siqoramil.extracker",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiUrl": "https://expensetracker.ovrin.uz",
      "googleWebClientId": "117558488241-6ic41go20uck8983jqe9k77i2oeqqkph.apps.googleusercontent.com",
      "googleIosClientId": "117558488241-clq1pfoivvjcnvs8diedcc5ml468sh28.apps.googleusercontent.com",
      "googleAndroidClientId": "117558488241-3g4g7r8lq2651ne0gimojtbe6rbvspem.apps.googleusercontent.com",
      "eas": {
        "projectId": "c9c42b83-a352-4234-b4c4-5958ed2489ed"
      }
    }
  }
}
